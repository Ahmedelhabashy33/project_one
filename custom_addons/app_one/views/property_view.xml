<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_edit" decoration-danger="(is_late)">
                <field name="name" />
                <field name="postcode" />
                <field name="owner_id" />
                <field name="state" />
                 <field name="is_late" invisible="1"/>
                <field name="active" />
                <field name="date_available" />
                <field name="selling_price" />
                <field name="garden" />
                <field name="garden_area" />
                <field name="facades" optional="1"/>
                <field name="garage" optional="1"/>

            </tree>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                         <button name="action_open_related_owner"
                                 type="object" icon="fa-user" string="Owner"  invisible="not owner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archive" bg_color="text-bg-danger" invisible="active"/>
                    <header>
                        <button name="action" type="object" string="Action" class="btn-success" invisible="state == 'draft'"/>
                        <button name="action_to_draft" type="object" string="draft" class="btn-success" invisible="state in ('draft','closed')"/>
                        <button name="action_to_sold" type="object" string="sold" class="btn-primary" invisible="state != 'pending' "/>
                        <button name="action_to_pending" type="object" string="pending" class="btn-secondary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" />
                    </header>
                    <div class="oe_title">
                        <label for="ref" />
                            <h1>
                                <field name="ref" />
                            </h1>
                        <label for="name" />
                            <h3>
                                <field name="name" readonly="state == 'closed'"/>
                            </h3>
                    </div>
                    <group>
                        <group string="Genral Info">
                             <field name="date_available" required="1" readonly="state == 'closed'"/>
                            <field name="expected_selling_date" readonly="state == 'closed'"/>
                             <field name="selling_price" readonly="state == 'closed'"/>
                            <field name="expected_price" readonly="state == 'closed'"/>
                            <field name="is_late" invisible="1" readonly="state == 'closed'"/>
                            <field name="diff" readonly="state == 'closed'"/>
                             <field name="garden" readonly="state == 'closed'"/>
                            <field name="postcode" readonly="state == 'closed'"/>
                            <field name="expected_selling_date" readonly="state == 'closed'"/>
                        </group>
                        <group string="Additional Info">
                              <field name="facades" readonly="state == 'closed'"/>
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="owner_address" readonly="state == 'closed'"/>
                            <field name="owner_phone" readonly="state == 'closed'"/>
                            <field name="active" invisible="1" readonly="state == 'closed'"/>
                              <field name="garden_area" readonly="state == 'closed'"/>
                              <field name="garage" readonly="state == 'closed'"/>
                              <field name="bedrooms" readonly="state == 'closed'"/>
                            <field name="garden_orientation" readonly="state == 'closed'"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color' , 'no_create': True}" placeholder="Select tags..." readonly="state == 'closed'"/>
                        </group>
                        <group>
                            <field name="description" required="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="bedrooms">
                             <field name="line_ids">
                            <tree editable="bottom">
                                <field name="description"/>
                                <field name="area"/>

                            </tree>
                             </field>
                        </page>
                    </notebook>


                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
 <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <filter name="is_Not_garage" string="with_out_garage" domain="[('garage','=',False)]" />
                <filter name="is_garden" string="with garden" domain="[('garden','=',True)]" />
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}" />
            </search>
        </field>
    </record>


    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property</field>
        <field name="res_model">property</field>
    </record>

    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">⛔︎ closed</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_to_closed()
        </field>
    </record>


    <record id="property_change_state_server_action" model="ir.actions.server">
        <field name="name">change state</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_change_state_wizard()
        </field>
    </record>

    <record id="check_selling_date_cron" model="ir.cron">
        <field name="name">property: check selling date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

</odoo>