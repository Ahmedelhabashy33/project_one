<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_edit">
                <field name="name" />
                <field name="postcode" />
                <field name="owner_id" />
                <field name="state" />
                <field name="active" />
                <field name="date_available" />
                <field name="selling_price" />
                <field name="garden" />
                <field name="garden_area" />
                <field name="facades" optional="1"/>
                <field name="garage" optional="1"/>

            </tree>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_to_draft" type="object" string="draft" class="btn-success" invisible="state == 'draft'"/>
                        <button name="action_to_sold" type="object" string="sold" class="btn-primary" invisible="state != 'pending' "/>
                        <button name="action_to_pending" type="object" string="pending" class="btn-secondary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" />
                    </header>
                    <div class="oe_title">
                        <label for="name" />
                            <h1>
                                <field name="name" />
                            </h1>
                    </div>
                    <group>
                        <group string="Genral Info">
                             <field name="date_available" required="1"/>
                             <field name="selling_price" />
                            <field name="expected_price" />
                            <field name="diff" />
                             <field name="garden" />
                            <field name="postcode" />
                            <field name="date_available" />

                        </group>
                        <group string="Additional Info">
                              <field name="facades" />
                            <field name="owner_id" />
                            <field name="owner_address" />
                            <field name="owner_phone" />
                            <field name="active" invisible="1"/>
                              <field name="garden_area" />
                              <field name="garage"/>
                              <field name="bedrooms"/>
                            <field name="garden_orientation"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color' , 'no_create': True}" placeholder="Select tags..."/>
                        </group>
                        <group>
                            <field name="description" required="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="bedrooms">
                             <field name="Line_ids">
                            <tree editable="bottom">
                                <field name="description"/>
                                <field name="area"/>

                            </tree>
                             </field>
                        </page>
                    </notebook>


                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
 <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <filter name="is_Not_garage" string="with_out_garage" domain="[('garage','=',False)]" />
                <filter name="is_garden" string="with garden" domain="[('garden','=',True)]" />
                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}" />
            </search>
        </field>
    </record>


    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property</field>
        <field name="res_model">property</field>
    </record>


</odoo>